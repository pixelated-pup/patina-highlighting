{
    "name": "Patina",
    "scopeName": "source.patina",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#literals"
        },
        {
            "include": "#types"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "comments": {
            "comment": "line comments",
            "name": "comment.line.double-slash.patina",
            "match": "//.*$"
        },
        "literals": {
            "patterns": [
                {
                    "comment": "decimal integers and floats",
                    "name": "constant.numeric.decimal.patina",
                    "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*([Ee](-?)([0-9][0-9_]*))?)?\\b"
                },
                {
                    "comment": "hexadecimal integers",
                    "name": "constant.numeric.hex.patina",
                    "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
                },
                {
                    "comment": "octal integers",
                    "name": "constant.numeric.oct.patina",
                    "match": "\\b0o[0-7][0-7_]*\\b"
                },
                {
                    "comment": "binary integers",
                    "name": "constant.numeric.bin.patina",
                    "match": "\\b0b[01][01_]*\\b"
                },
                {
                    "comment": "booleans",
                    "name": "constant.language.bool.patina",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "control flow keywords",
                    "name": "keyword.control.patina",
                    "match": "\\b(if|else|match|for|in|loop|return|break|continue)\\b"
                },
                {
                    "comment": "import keyword",
                    "name": "storage.type.import.patina",
                    "match": "\\bimport\\b"
                },
                {
                    "comment": "let keyword",
                    "name": "storage.type.let.patina",
                    "match": "\\blet\\b"
                },
                {
                    "comment": "def keyword",
                    "name": "storage.type.def.patina",
                    "match": "\\bdef\\b"
                },
                {
                    "comment": "impl keyword",
                    "name": "storage.type.impl.patina",
                    "match": "\\bimpl\\b"
                },
                {
                    "comment": "type keyword",
                    "name": "storage.type.type.patina",
                    "match": "\\btype\\b"
                },
                {
                    "comment": "pub keyword",
                    "name": "storage.modifier.pub.patina",
                    "match": "\\bpub\\b"
                },
                {
                    "comment": "opaque keyword",
                    "name": "storage.modifier.opaque.patina",
                    "match": "\\bopaque\\b"
                },
                {
                    "comment": "fn keyword",
                    "name": "keyword.other.fn.patina",
                    "match": "\\bfn\\b"
                },
                {
                    "comment": "mut keyword",
                    "name": "storage.modifier.mut.patina",
                    "match": "\\bmut\\b"
                },
                {
                    "comment": "print keyword",
                    "name": "variable.language.print.patina",
                    "match": "\\bprint\\b"
                },
                {
                    "comment": "logical operators",
                    "name": "keyword.operator.logical.patina",
                    "match": "(\\^|\\||\\|\\||&&|!)(?!=)"
                },
                {
                    "comment": "assignment operators",
                    "name": "keyword.operator.assignment.patina",
                    "match": "(\\+=|-=|\\*=|/=|\\*\\*=)"
                },
                {
                    "comment": "single equal",
                    "name": "keyword.operator.assignment.patina",
                    "match": "(?<![<>])=(?!=)"
                },
                {
                    "comment": "comparison operators",
                    "name": "keyword.operator.comparison.patina",
                    "match": "(==|!=|<=|>=)"
                },
                {
                    "comment": "math operators",
                    "name": "keyword.operator.math.patina",
                    "match": "(([+*]|(\\*\\*))(?!=))|(-(?!>))|(/(?!/))"
                },
                {
                    "comment": "namespace operator",
                    "name": "keyword.operator.namespace.patina",
                    "match": "::"
                },
                {
                    "comment": "dot access",
                    "name": "keyword.operator.dot.patina",
                    "match": "\\."
                },
                {
                    "comment": "colon",
                    "name": "keyword.operator.colon.patina",
                    "match": ":"
                },
                {
                    "comment": "arrow",
                    "name": "keyword.operator.arrow.patina",
                    "match": "->"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "comment": "numeric types",
                    "name": "entity.name.type.numeric.patina",
                    "match": "\\b(Int|UInt|Byte|Float)\\b"
                },
                {
                    "comment": "primitive types",
                    "name": "entity.name.type.primitive.patina",
                    "match": "\\b(Bool)\\b"
                },
                {
                    "comment": "types",
                    "name": "entity.name.type.patina",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "comment": "comma",
                    "name": "punctuation.comma.patina",
                    "match": ","
                },
                {
                    "comment": "curly braces",
                    "name": "punctuation.brackets.curly.patina",
                    "match": "[{}]"
                },
                {
                    "comment": "parentheses, round brackets",
                    "name": "punctuation.brackets.round.patina",
                    "match": "[()]"
                },
                {
                    "comment": "square brackets",
                    "name": "punctuation.brackets.square.patina",
                    "match": "[\\[\\]]"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "strings",
                    "name": "string.quoted.double.patina",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "include": "#escapes"
                        }
                    ]
                }
            ]
        },
        "escapes": {
            "comment": "escapes",
            "name": "constant.character.escape.patina",
            "match": "\\\\(?:\\\\|'|\"|0|t|n|r|(u\\{[0-9a-fA-F]{1,6}\\}))"
        },
        "variables": {
            "patterns": [
                {
                    "comment": "variable name",
                    "name": "variable.other.patina",
                    "match": "\\b[a-z][a-z0-9_]*\\b"
                },
                {
                    "comment": "constant name",
                    "name": "constant.other.caps.patina",
                    "match": "\\b[A-Z][A-Z0-9_]*\\b"
                }
            ]
        }
    }
}